<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VideoDownloader.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="200"
        x:Class="VideoDownloader.Views.MainWindow"
        Width="500"
        Height="200"
        CanResize="False"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/veo_down_logo.png"
        Title="VeoDownloader">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Window">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontFamily" Value="Menlo" />
        </Style>
        <Style Selector="Button">
            <Setter Property="Width" Value="200" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CornerRadius" Value="25" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="25" />
            <Setter Property= "MaxLines" Value="1"/>

        </Style>
    </Window.Styles>
        <!-- <TextBlock Text="{Binding Greeting}" HorizontalAlignment="Center" VerticalAlignment="Center" /> -->

        <DockPanel LastChildFill="True">
            <Border Height="20" Background="DimGray" BorderBrush="Black" BorderThickness="1" DockPanel.Dock="Bottom">
                <TextBlock Foreground="WhiteSmoke" FontSize="10" VerticalAlignment="Center" Padding="5 0">Bottom Dock Text</TextBlock>
            </Border>

            <Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBox
                        Name="LinkTextBox"
                        TextAlignment="Center"
                        MaxLines="1"
                        Width="400"
                        Watermark="Input VEO Website Link"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Margin="0, 0, 0, 10">
                    </TextBox>

                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">
                        <Button Name="DownloadBtn" Content="Download" />
                        <Button Name="SelectDirBtn" Content="Download Location" />
                    </StackPanel>

                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">
                        <ProgressBar
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Width="350"
                            Height="25"
                            Margin="0, 10, 5, 10"
                            CornerRadius="25"
                            ShowProgressText="True"
                            Value="25"
                            FontSize="10"
                            FontStyle="Italic"
                            Foreground="Gray">
                        </ProgressBar>
                        <Button Name="StopDownloadBtn"
                                Click="StopDownloadClk"
                                Width="25"
                                Height="25"
                                Margin="5, 0, 0, 0"
                                CornerRadius="25"
                                Background="Black">
                            <Image Source="/Assets/stop-circle.png" Stretch="Fill"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DockPanel>





</Window>
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>

    <!-- Add Styles Here -->
    <!-- These styles will override the ones set within App.axaml
        You then have to link them in the MainWindow.axaml with:
        
        <Window.Styles>
            <StyleInclude Source="/MainWindow_style.axaml" />
        </Window.Styles>

        -->

    <Style Selector="Label">
        <Setter Property="HorizontalAlignment" Value="Center"></Setter>
        <Setter Property="Margin" Value="0 5"></Setter>
    </Style>
    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="25" />
        <Setter Property="Margin" Value="20 0"></Setter>
    </Style>
    <Style Selector="Button">
        <Setter Property="Margin" Value="20 0"></Setter>
        <Setter Property="Width" Value="200"></Setter>
        <Setter Property="Height" Value="50"></Setter>
        <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
        <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
    </Style>
    <Style Selector="StackPanel">
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>
    
    <Style Selector="ProgressBar">
        <Setter Property="Width" Value="350"></Setter>  
        <Setter Property="Height" Value="20"></Setter>  
        <Setter Property="CornerRadius" Value="25"></Setter>
        <Setter Property="Value" Value="50"></Setter>
        <Setter Property="ShowProgressText" Value="True"></Setter>
    </Style>
    
    
    <!-- use <Object.Classes>NewClassName</Object.Classes>" to name a certain selector.
    call it here with Object.Classname like below. -->
    <Style Selector="StackPanel.MainArea">
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="StackPanel.ButtonPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0 15"></Setter>
    </Style>

    <Style Selector="Button.StopBtn">
        <Setter Property="Width" Value="25"></Setter>
        <Setter Property="Height" Value="25"></Setter>
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    
    <Style Selector="Border.StopImage">
        <Setter Property="Width" Value="40"></Setter>
        <Setter Property="Height" Value="40"></Setter>
        <Setter Property="Background" Value="Red"></Setter>
        <Setter Property="BorderThickness" Value="20"></Setter>
        <Setter Property="OpacityMask">
            <VisualBrush>
                <VisualBrush.Visual>
                    <Image Source="/Assets/stop-circle.png" />
                </VisualBrush.Visual>
            </VisualBrush>
        </Setter>
    </Style>


</Styles>